---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { LANG_CODES, T, type Lang } from '../../i18n';
export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all.map(a => {
    const [lang, ...rest] = a.id.split('/');
    const slug = rest.join('/');
    // langues où cet article existe (pour hreflang)
    const langs = LANG_CODES.filter(l => all.some(b => b.id === `${l}/${slug}`));
    return { params: { lang, slug }, props: { a, langs } };
  });
}
const { a, langs } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = T[lang];
const { Content } = await render(a);
const d = a.data;
const prettyUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base lang={lang} title={d.title} description={d.description} langs={langs}>
  <span class:list={['tag', d.category]}>{t.cats[d.category]}</span>
  <h1>{d.title}</h1>
  <p class="meta">{t.published} {d.date.toLocaleDateString(lang, { day: 'numeric', month: 'long', year: 'numeric' })}</p>
  {d.image && <figure class="photo"><Image src={d.image} alt={d.title} width={1200} format="webp" loading="eager" />{d.image_credit && <figcaption>{d.image_credit}</figcaption>}</figure>}
  {d.sponsored && <p class="sponsored">{t.partner}</p>}
  {(d.address || d.website || d.maps) && (
    <div class="plaque">
      {d.address && <div><span class="k">{t.address}</span> {d.address}</div>}
      {d.website && <div><span class="k">{t.site}</span> <a href={d.website} rel="nofollow noopener">{prettyUrl(d.website)}</a></div>}
      {d.maps && <div><span class="k">{t.map}</span> <a href={d.maps} rel="noopener">{t.mapLink}</a></div>}
    </div>
  )}
  <article class="body"><Content /></article>
</Base>
