---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { CATEGORIES, type Category } from '../../content.config';
export function getStaticPaths() {
  return Object.keys(CATEGORIES).map(cat => ({ params: { cat } }));
}
const cat = Astro.params.cat as Category;
const base = import.meta.env.BASE_URL;
const label = CATEGORIES[cat];
const articles = (await getCollection('articles', a => a.data.category === cat)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${label} à Bruxelles`} description={`${label} à Bruxelles : nos adresses vérifiées, une par jour.`}>
  <span class:list={['tag', cat]}>{label}</span>
  <h1>{label} à Bruxelles</h1>
  {articles.length === 0 && <p class="lead">Rien encore ici. Ça arrive, un article par jour.</p>}
  <div class="cards">
    {articles.map(a => (
      <a class:list={['card', { pic: !!a.data.image }]} href={`${base}${a.id}/`}>
        {a.data.image && <Image class="thumb" src={a.data.image} alt="" width={480} height={360} format="webp" />}
        <div>
        <h3>{a.data.title}</h3>
        <p>{a.data.description}</p>
        {a.data.address && <p class="meta">{a.data.address}</p>}
        </div>
      </a>
    ))}
  </div>
</Base>
