---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../content.config';
export async function getStaticPaths() {
  return (await getCollection('articles')).map(a => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
const base = import.meta.env.BASE_URL;
const d = a.data;
const prettyUrl = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Base title={d.title} description={d.description}>
  <span class:list={['tag', d.category]}>{CATEGORIES[d.category]}</span>
  <h1>{d.title}</h1>
  <p class="meta">Publié le {d.date.toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
  {d.sponsored && <p class="sponsored">Article réalisé en partenariat avec l'établissement.</p>}
  {(d.address || d.website || d.maps) && (
    <div class="plaque">
      {d.address && <div><span class="k">Adresse</span> {d.address}</div>}
      {d.website && <div><span class="k">Site</span> <a href={d.website} rel="nofollow noopener">{prettyUrl(d.website)}</a></div>}
      {d.maps && <div><span class="k">Plan</span> <a href={d.maps} rel="noopener">Ouvrir dans Google Maps</a></div>}
    </div>
  )}
  <article class="body"><Content /></article>
  <div class="cta">
    <span class="display">Vous tenez un établissement à Bruxelles ?</span>
    <p>On écrit un article dédié, lu par des Bruxellois qui cherchent où sortir ce week-end.</p>
    <a class="btn" href={`${base}referencer/`}>Voir les offres</a>
  </div>
</Base>
