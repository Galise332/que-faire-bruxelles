---
import { LANGS, LANG_CODES, DEFAULT_LANG } from '../i18n';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Que faire à Bruxelles</title>
  <meta name="robots" content="noindex" />
  {LANG_CODES.map(l => <link rel="alternate" hreflang={l} href={`/${l}/`} />)}
  <link rel="alternate" hreflang="x-default" href={`/${DEFAULT_LANG}/`} />
  <meta http-equiv="refresh" content={`2;url=/${DEFAULT_LANG}/`} />
  <script define:vars={{ codes: LANG_CODES, def: DEFAULT_LANG }}>
    // langue du navigateur si on la propose, sinon français
    const want = (navigator.languages || [navigator.language || '']).map(l => l.slice(0, 2).toLowerCase());
    location.replace('/' + (want.find(l => codes.includes(l)) || def) + '/');
  </script>
  <style>body{font:17px system-ui,sans-serif;padding:24px;background:#FBF6EA} a{display:inline-block;margin:4px 12px 4px 0}</style>
</head>
<body>
  {LANG_CODES.map(l => <a href={`/${l}/`} lang={l}>{LANGS[l]}</a>)}
</body>
</html>
